# Kopiere diese Datei zu ".env" und trag deine Werte ein. Die .env wird nie hochgeladen (.gitignore).

# --- Supabase (PFLICHT für Anmeldung/Registrierung) ---------------------------
# Supabase-Dashboard → Project Settings → API Keys (bzw. "Data API" für die URL)
ZWIP_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Der ÖFFENTLICHE Key: "Publishable key" (sb_publishable_…) oder alter "anon public" Key (eyJ…).
# Den darf man veröffentlichen – die Datenbankregeln schützen die Daten.
# NIEMALS den "secret" / "service_role" Key eintragen. Der Build bricht dann bewusst ab.
ZWIP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Optional -----------------------------------------------------------------
# Öffentliche Adresse der App – wird in Teilen- und Duell-Links verwendet.
# Leer lassen = aktuelle Adresse im Browser.
ZWIP_PUBLIC_URL=

# Port für den lokalen Dev-Server
PORT=5173
