# Alle Werte sind optional. Ohne .env läuft ZWIP komplett offline
# (Daily, Streaks, Duell-Links und Crew-Bestenliste funktionieren trotzdem).

# Öffentliche Adresse der App – wird in Teilen- und Duell-Links verwendet.
# Leer lassen = aktuelle Adresse im Browser.
ZWIP_PUBLIC_URL=https://dein-name.github.io/zwip/

# Globale Tages-Bestenliste (Supabase Free Tier, siehe DEPLOYMENT.md).
# Den "anon public" Key darfst du veröffentlichen – die Datenbankregeln schützen die Tabelle.
ZWIP_SUPABASE_URL=
ZWIP_SUPABASE_ANON_KEY=

# Port für den lokalen Dev-Server
PORT=5173
