# Cloudflare Pages / Netlify: Startseite und Service Worker immer frisch laden,
# die Spieldateien (app-<hash>.js/.css) dürfen ewig gecacht werden – jede Version hat einen neuen Namen.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/app-*
  Cache-Control: public, max-age=31536000, immutable
