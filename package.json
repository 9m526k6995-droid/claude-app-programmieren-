{
  "name": "zwip",
  "private": true,
  "version": "0.1.0",
  "description": "ZWIP – 10 Blitz-Challenges in 30 Sekunden. Jeden Tag neu.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "build:single": "node build.mjs --single",
    "typecheck": "tsc -p .",
    "test": "tsc -p . && node tests/run-unit.mjs",
