    "test:e2e": "node tests/e2e.mjs",
    "preview": "node build.mjs && npx --yes serve dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
